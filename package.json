{
  "name": "@tertium/deploy",
  "version": "0.1.0",
  "description": "Runs a project's own GitHub Actions-style deploy workflow on your machine, with envs from envlock.",
  "author": {
    "name": "Vitalii Balabanov",
    "email": "tertiumnon@gmail.com",
    "url": "https://github.com/Tertiumnon"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tertiumnon/tertium-deploy"
  },
  "homepage": "https://github.com/Tertiumnon/tertium-deploy",
  "keywords": ["deploy", "workflow", "github-actions", "ssh"],
  "type": "module",
  "bin": {
    "deploy": "src/workflow/workflow.ts"
  },
  "files": ["src", "!src/**/*.test.ts"],
  "scripts": {
    "lint": "biome check src",
    "typecheck": "bun check",
    "test": "bun test",
    "release:patch": "gith release --patch --update-version --npm",
    "release:minor": "gith release --minor --update-version --npm",
    "release:major": "gith release --major --update-version --npm"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "1.3.9"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
